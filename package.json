{
  "name": "cadloom",
  "version": "0.2.0-alpha.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "prove": "node formal/scripts/verify.mjs",
    "check": "npm run typecheck && npm test && npm run prove",
    "example": "node examples/box-and-cylinder-mesh.ts && node examples/primitives-and-sweeps.ts && node examples/intersections.ts",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^24.0.0"
  },
  "description": "Pure TypeScript B-rep CAD kernel, a reimplementation of the SolidCraft/solidcore kernel, with Lean-checked models",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yukiharada1228/cadloom.git"
  },
  "homepage": "https://github.com/yukiharada1228/cadloom#readme",
  "bugs": {
    "url": "https://github.com/yukiharada1228/cadloom/issues"
  },
  "keywords": [
    "cad",
    "cad-kernel",
    "brep",
    "nurbs",
    "geometry",
    "typescript",
    "lean4"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
